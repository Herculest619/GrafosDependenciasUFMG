{
    "name": "grafos-dependencias-ufmg",
    "version": "3.0.0",
    "private": true,
    "description": "Grafos de dependências de disciplinas dos cursos de graduação da UFMG",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint . --ext .vue,.js,.mjs --fix --ignore-path .gitignore",
        "format": "prettier --write src/ scripts/ tests/",
        "test": "node --test",
        "data:build": "node scripts/build-data.mjs",
        "data:validate": "node scripts/validate-data.mjs",
        "data:fetch": "node scripts/fetch-source.mjs",
        "check:sfc": "node scripts/check-sfc.mjs",
        "check": "npm run test && npm run data:validate && npm run check:sfc"
    },
    "dependencies": {
        "vis-data": "^7.1.6",
        "vis-network": "^9.1.6",
        "vis-util": "^5.0.3",
        "vue": "^3.2.47",
        "vue-router": "^4.1.6"
    },
    "devDependencies": {
        "@rushstack/eslint-patch": "^1.2.0",
        "@vitejs/plugin-vue": "^4.0.0",
        "@vitejs/plugin-vue-jsx": "^3.0.0",
        "@vue/compiler-sfc": "^3.2.47",
        "@vue/eslint-config-prettier": "^7.1.0",
        "autoprefixer": "^10.4.14",
        "eslint": "^8.34.0",
        "eslint-plugin-vue": "^9.9.0",
        "postcss": "^8.4.21",
        "prettier": "^2.8.4",
        "tailwindcss": "^3.3.1",
        "vite": "^4.1.4"
    }
}
